{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "premiumstore-chatbot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "premiumstore-chatbot"
    }
  ],
  "observability": {
    "enabled": true
  },
  
  "vars": {
    "EMAIL_FROM": "Premium Store <no-reply@premiumstore.online>",
    "CHAT_URL": "https://premiumstore.online/",
  }

}